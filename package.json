{
  "name": "actionproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verifiable execution and recovery for agent actions",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server/index.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:sandbox": "vite build --mode sandbox",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node mcp/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
